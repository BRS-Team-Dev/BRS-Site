# Copy to .env (at project root) and fill in real values.
# This file is the ONLY source of credentials for the PHP backend.
# Never commit a real .env — it's gitignored.

# Environment label: local | dev | prod  (drives runtime branching)
BRS_ENV=local

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=builtrightstudio_cms
DB_USER=root
DB_PASS=

# --- Auth / JWT ---
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change-me-to-a-64-char-random-hex-string
JWT_TTL=28800

# --- App ---
# Public-facing base URL (used in unsubscribe links, etc.). NO trailing slash.
BASE_URL=http://localhost/builtrightstudio
UPLOAD_MAX_MB=10

# --- Stripe billing ---
# Dashboard → Developers → API keys. Test mode keys start `sk_test_` /
# `pk_test_`; live starts `sk_live_` / `pk_live_`. Use test until launch.
# STRIPE_SECRET=sk_test_...
# STRIPE_PUBLISHABLE=pk_test_...
# Webhook signing secret from Dashboard → Developers → Webhooks →
# your endpoint. Endpoint URL is <BASE_URL>/cms/api/stripe-webhook
# STRIPE_WEBHOOK_SECRET=whsec_...
# When true, /public/tenant-signup refuses signups without a
# payment_method_id. Kills the "sign up, cancel, sign up again"
# trial-farming loop by requiring the user to attach a card even for
# the free trial (the card is not charged, just saved via SetupIntent).
# TRIAL_REQUIRES_CARD=false

# Price IDs from Dashboard → Products. One per subscription tier.
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_SCALE=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# --- System email fallback (optional) ---
# Absolute last-resort SMTP used when a tenant has NO email provider
# configured AND no legacy `settings.smtp_*` row either. Every send
# through this fallback is tagged with `X-BRS-System-Fallback: 1` so
# it's obvious downstream. Leave commented to disable — a tenant with
# nothing configured will then fail to send instead of silently using
# your infrastructure. Enabling this puts every fallback send on YOUR
# domain's reputation, so use it as a safety net only.
# SYSTEM_SMTP_HOST=smtp.hostinger.com
# SYSTEM_SMTP_PORT=587
# SYSTEM_SMTP_USER=hello@builtrightstudio.com
# SYSTEM_SMTP_PASS=your-mailbox-password
# SYSTEM_SMTP_ENC=tls
# SYSTEM_SMTP_FROM=hello@builtrightstudio.com
# SYSTEM_SMTP_FROM_NAME=BuiltRightStudio
