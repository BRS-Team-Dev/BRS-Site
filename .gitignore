# --- CMS subfolder ---

# Dependencies / build artefacts
/cms/api/vendor/
/cms/api/composer.phar
/cms/frontend/node_modules/
/cms/frontend/dist/
/cms/frontend/.angular/

# Playwright e2e — node_modules + runtime artefacts.
# Chromium binaries live in the user AppData cache (not tracked).
/cms/e2e/node_modules/
/cms/e2e/test-results/
/cms/e2e/playwright-report/
/cms/e2e/screenshots/
/cms/e2e/.auth/

# Secrets / per-machine config
/cms/.env
/cms/.env.*
!/cms/.env.example
# NOTE: cms/api/config.php was legacy-sensitive (held DB creds inline). Post-refactor
# it's a generic .env loader with no secrets, so it ships with the repo.

# Runtime / user data
/cms/uploads/
/cms/storage/

# Local seed scripts (XAMPP only) — at repo root for legacy reasons
/seed_test_*.php

# --- Project-wide ---
/memory.md
/docs/
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
Moving your domain to a new registrar do.md
